# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- required ---
DISCORD_TOKEN=
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=shopmanagerv2

# --- optional: CommendBot integration ---------------------------------
# A second cluster belonging to a CommendBot deployment
# (github.com/PeterLinuxOSS/commendbot). Needed only to sell commends against
# an existing CommendBot balance; leave empty to run the shop standalone.
COMMENDBOT_MONGODB_URI=

# --- discord ---
OWNER_ID=
COMMAND_PREFIX=s!
TESTING_GUILD_IDS=
MAIN_GUILD_ID=
STAFF_GUILD_ID=

# --- log channels ---
TRANSCRIPT_LOG_CHANNEL_ID=
OWNER_LOG_CHANNEL_ID=
ORDER_LOG_CHANNEL_ID=

# --- branding ---
BRAND_NAME=ShopManager
BRAND_URL=https://example.com
BRAND_LOGO_URL=
BRAND_FOOTER=powered by ShopManager
BRAND_COLOR=708290

# --- custom emoji (leave blank to fall back to the originals) ---
EMOJI_YES=
EMOJI_NO=
EMOJI_WAIT=
EMOJI_PAYPAL=
EMOJI_ADD=

# --- images (re-host these; the originals were expiring Discord CDN links) ---
IMAGE_SETUP_TUTORIAL=
IMAGE_PRODUCT_TUTORIAL=
IMAGE_STYLE_TUTORIAL=
IMAGE_WARNING_ICON=
IMAGE_STANDARD_BANNER=

# --- logging ---
LOG_LEVEL=INFO
LOG_FILE=nextcord.log
